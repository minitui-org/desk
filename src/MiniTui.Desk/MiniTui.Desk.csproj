<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tuidesk</AssemblyName>
    <RootNamespace>MiniTui.Desk</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Build hardening -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- A .NET tool with a Native AOT binary per platform (spec §16.3) -->
    <IsPackable>true</IsPackable>
    <PackageId>MiniTui.Desk</PackageId>
    <Description>MiniTui Desk: a focus-first workspace in the terminal. One app on the screen, or two, a status line, quiet notifications, and apps that know they are in it.</Description>
    <PackageTags>tui;terminal;minitui;desk</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tuidesk</ToolCommandName>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MiniTui.Vt/MiniTui.Vt.csproj" />
    <ProjectReference Include="../MiniTui.Desk.Protocol/MiniTui.Desk.Protocol.csproj" />
    <InternalsVisibleTo Include="MiniTui.Desk.Tests" />
  </ItemGroup>

</Project>
