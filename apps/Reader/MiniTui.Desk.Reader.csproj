<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reader, the third first-party app (spec §13.10) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tuireader</AssemblyName>
    <RootNamespace>MiniTui.Desk.Reader</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Build hardening -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <IsAotCompatible>true</IsAotCompatible>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MiniTui.Desk.Protocol/MiniTui.Desk.Protocol.csproj" />
    <InternalsVisibleTo Include="MiniTui.Desk.Reader.Tests" />
  </ItemGroup>

</Project>
