<Project Sdk="Microsoft.NET.Sdk">

  <!-- Notes, the first first-party app (spec §13.8) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tuinotes</AssemblyName>
    <RootNamespace>MiniTui.Desk.Notes</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Build hardening -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <IsAotCompatible>true</IsAotCompatible>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- A .NET tool with a Native AOT binary per platform (spec §16.3) -->
    <IsPackable>true</IsPackable>
    <PackageId>MiniTui.Desk.Notes</PackageId>
    <Description>Notes for the terminal: Markdown notes in plain files, with a list and an editor. Made for MiniTui Desk, and works on its own.</Description>
    <PackageTags>tui;terminal;minitui;desk</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tuinotes</ToolCommandName>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MiniTui.Desk.Protocol/MiniTui.Desk.Protocol.csproj" />
    <InternalsVisibleTo Include="MiniTui.Desk.Notes.Tests" />
  </ItemGroup>

</Project>
